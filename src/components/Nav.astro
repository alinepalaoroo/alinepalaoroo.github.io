---
const rotas = [
  { href: '/', texto: 'Início' },
  { href: '/cases/', texto: 'Cases' },
  { href: '/blog/', texto: 'Blog' },
  { href: '/sobre/', texto: 'Sobre' },
];
const atual = Astro.url.pathname;
---
<nav aria-label="Navegação principal">
  <ul>
    {rotas.map((r) => (
      <li>
        <a href={r.href} aria-current={atual === r.href ? 'page' : undefined}>{r.texto}</a>
      </li>
    ))}
  </ul>
</nav>
<style>
  nav { max-width: var(--largura-leitura); margin: 0 auto; padding: 1.75rem 1.25rem 2.5rem; }
  ul { display: flex; flex-wrap: wrap; gap: 1.25rem; list-style: none; margin: 0; padding: 0; }
  a {
    color: var(--cor-suave);
    text-decoration: none;
    font-size: 0.95rem;
    padding-bottom: 0.2rem;
    border-bottom: 2px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }
  a:hover { color: var(--cor-texto); border-color: var(--cor-borda); }
  a[aria-current='page'] {
    color: var(--cor-texto);
    font-weight: 600;
    border-color: var(--cor-destaque);
  }
</style>
